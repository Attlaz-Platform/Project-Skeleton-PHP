{
  "name": "attlaz/skeleton",
  "description": "Skeleton to start a new Attlaz PHP project",
  "keywords": [
    "attlaz",
    "connect",
    "connection",
    "integrate",
    "synchronize",
    "automate"
  ],
  "license": "MIT",
  "type": "project",
  "homepage": "https://attlaz.com",
  "require": {
    "php": "^8.4",
    "attlaz/project-base": "^1.18",
    "attlaz/adapter-base": "^1.20"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/App"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "monolog/monolog": "^3.0",
    "bramus/monolog-colored-line-formatter": "~3.0"
  },
  "repositories": [
  ],
  "scripts": {
    "post-autoload-dump": "Attlaz\\Project\\Setup\\Install::run"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
